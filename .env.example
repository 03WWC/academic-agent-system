# LLM 配置
# 代码统一读取 OPENAI_* 前缀，可指向任意 OpenAI 兼容接口（示例为 DeepSeek）
OPENAI_API_KEY=your_api_key
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash
MAX_TOKENS=1000

# 教务 SQLite 数据库路径
SQLITE_DB_PATH=./customer_support_chat/data/academic.sqlite

# Embedding 配置
USE_LOCAL_EMBEDDINGS=true
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_API_KEY=

# Qdrant 配置（变量名与 app/core/settings.py 保持一致）
QDRANT_URL=http://localhost:6333
QDRANT_KEY=

# 可选：LangSmith 追踪
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=multi-agent-rag-customer-support

# 可选：人工审核服务
GOHUMANLOOP_API_KEY=
