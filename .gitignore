.env
# 覆盖 .venv 以及为更新 poetry.lock 临时创建的 .venv-poetry 等环境目录
.venv*/
__pycache__/
*.py[cod]
*.pyo

# 本地运行产生的会话数据与日志
user_data/*.json
*.log

# 本地工具和编辑器文件
.idea/
.vscode/
.DS_Store
Thumbs.db

# 个人面试资料与本地数据库，不纳入版本管理
面试资料/
*.sqlite

# 测试缓存
.pytest_cache/

# 个人文档（运行手册 / 面试讲解稿 / 作品集说明）与架构图，仅在本地保留
PROJECT_RUNBOOK.md
INTERVIEW_SCRIPT.md
AI_AGENT_PORTFOLIO.md
graphs/
